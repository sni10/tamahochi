; Engine configuration file.

config_version=5

[application]

config/name="Pixel Pet"
config/icon="res://assets/icon/icon_192.png"
config/version="0.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.9647059, 0.9372549, 0.8627451, 1)

[display]

window/size/viewport_width=540
window/size/viewport_height=1170
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/pet_notify/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[debug]

gdscript/warnings/integer_division=0
